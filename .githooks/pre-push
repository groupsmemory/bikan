#!/bin/sh
# ─────────────────────────────────────────────────────────
# BIKAN Pre-Push Hook
# Mencegah push kode yang break tests
# ─────────────────────────────────────────────────────────
# Install: git config core.hooksPath .githooks
# ─────────────────────────────────────────────────────────

echo "🧪 BIKAN Pre-Push: Running tests..."
echo ""

npm run test

if [ $? -ne 0 ]; then
  echo ""
  echo "❌ Tests FAILED. Push dibatalkan."
  echo "   Perbaiki test yang gagal sebelum push."
  echo ""
  exit 1
fi

echo ""
echo "✅ All tests passed. Pushing..."
echo ""
exit 0
