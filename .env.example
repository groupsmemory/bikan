# BIKAN LMS Environment Variables
# Copy this file to .env.local and fill in your values

# Gemini AI API Key (from https://aistudio.google.com/apikey)
GEMINI_API_KEY="your_gemini_api_key_here"

# NeonDB PostgreSQL Connection String (from https://neon.tech dashboard)
DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"

# Video Source Toggle
# Set to "true" to use local HLS files from public/videos/ (production)
# Set to "false" to use Apple/Mux test streams (development)
NEXT_PUBLIC_USE_LOCAL_VIDEOS="false"

# Upstash Redis (Rate Limiting)
# Get from: https://console.upstash.com → Create Database → REST API
UPSTASH_REDIS_REST_URL="https://your-redis.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_token_here"
